<?xml version="1.0" encoding="utf-8"?>
<!--
    Tools Panel — قائمة رأسية بالأدوات المتاحة
    الـ IDs مربوطة بـ PanelManager.showToolsPanel()
    كل زرار بيتحدد background حسب الـ Selected State في الـ Kotlin Code
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="156dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_panel"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:elevation="8dp">

    <!-- Pen -->
    <TextView
        android:id="@+id/tool_pen"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center"
        android:text="@string/tool_pen"
        android:textSize="14sp"
        android:textColor="@color/tool_item_text_default"
        android:background="@drawable/bg_tool_item_default"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="3dp"
        android:fontFamily="sans-serif" />

    <!-- Laser -->
    <TextView
        android:id="@+id/tool_laser"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center"
        android:text="@string/tool_laser"
        android:textSize="14sp"
        android:textColor="@color/tool_item_text_default"
        android:background="@drawable/bg_tool_item_default"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="3dp"
        android:fontFamily="sans-serif" />

    <!-- Rectangle -->
    <TextView
        android:id="@+id/tool_rectangle"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center"
        android:text="@string/tool_rectangle"
        android:textSize="14sp"
        android:textColor="@color/tool_item_text_default"
        android:background="@drawable/bg_tool_item_default"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="3dp"
        android:fontFamily="sans-serif" />

    <!-- Ellipse -->
    <TextView
        android:id="@+id/tool_ellipse"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center"
        android:text="@string/tool_ellipse"
        android:textSize="14sp"
        android:textColor="@color/tool_item_text_default"
        android:background="@drawable/bg_tool_item_default"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="3dp"
        android:fontFamily="sans-serif" />

    <!-- Stroke Eraser -->
    <TextView
        android:id="@+id/tool_stroke_eraser"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center"
        android:text="@string/tool_stroke_eraser"
        android:textSize="14sp"
        android:textColor="@color/tool_item_text_default"
        android:background="@drawable/bg_tool_item_default"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="3dp"
        android:fontFamily="sans-serif" />

    <!-- Pixel Eraser -->
    <TextView
        android:id="@+id/tool_pixel_eraser"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center"
        android:text="@string/tool_pixel_eraser"
        android:textSize="14sp"
        android:textColor="@color/tool_item_text_default"
        android:background="@drawable/bg_tool_item_default"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:fontFamily="sans-serif" />

</LinearLayout>
