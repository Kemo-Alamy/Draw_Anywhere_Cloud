<?xml version="1.0" encoding="utf-8"?>
<!--
    Tools Panel — 11 أداة كاملة
    IDs مربوطة بـ PanelManager.showToolsPanel()
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="164dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_panel"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:elevation="8dp">

    <!-- Pen -->
    <TextView
        android:id="@+id/tool_pen"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:gravity="center"
        android:text="@string/tool_pen"
        android:textSize="14sp"
        android:textColor="@color/tool_item_text_default"
        android:background="@drawable/bg_tool_item_default"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="3dp"
        android:fontFamily="sans-serif" />

    <!-- Matte Pen -->
    <TextView
        android:id="@+id/tool_matte_pen"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:gravity="center"
        android:text="@string/tool_matte_pen"
        android:textSize="14sp"
        android:textColor="@color/tool_item_text_default"
        android:background="@drawable/bg_tool_item_default"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="3dp"
        android:fontFamily="sans-serif" />

    <!-- Laser -->
    <TextView
        android:id="@+id/tool_laser"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:gravity="center"
        android:text="@string/tool_laser"
        android:textSize="14sp"
        android:textColor="@color/tool_item_text_default"
        android:background="@drawable/bg_tool_item_default"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="3dp"
        android:fontFamily="sans-serif" />

    <!-- Brush -->
    <TextView
        android:id="@+id/tool_brush"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:gravity="center"
        android:text="@string/tool_brush"
        android:textSize="14sp"
        android:textColor="@color/tool_item_text_default"
        android:background="@drawable/bg_tool_item_default"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="3dp"
        android:fontFamily="sans-serif" />

    <!-- Highlighter -->
    <TextView
        android:id="@+id/tool_highlighter"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:gravity="center"
        android:text="@string/tool_highlighter"
        android:textSize="14sp"
        android:textColor="@color/tool_item_text_default"
        android:background="@drawable/bg_tool_item_default"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="3dp"
        android:fontFamily="sans-serif" />

    <!-- Calligraphy -->
    <TextView
        android:id="@+id/tool_calligraphy"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:gravity="center"
        android:text="@string/tool_calligraphy"
        android:textSize="14sp"
        android:textColor="@color/tool_item_text_default"
        android:background="@drawable/bg_tool_item_default"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="3dp"
        android:fontFamily="sans-serif" />

    <!-- Lasso -->
    <TextView
        android:id="@+id/tool_lasso"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:gravity="center"
        android:text="@string/tool_lasso"
        android:textSize="14sp"
        android:textColor="@color/tool_item_text_default"
        android:background="@drawable/bg_tool_item_default"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="3dp"
        android:fontFamily="sans-serif" />

    <!-- فاصل -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/panel_section_divider"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="3dp" />

    <!-- Rectangle -->
    <TextView
        android:id="@+id/tool_rectangle"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:gravity="center"
        android:text="@string/tool_rectangle"
        android:textSize="14sp"
        android:textColor="@color/tool_item_text_default"
        android:background="@drawable/bg_tool_item_default"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="3dp"
        android:fontFamily="sans-serif" />

    <!-- Ellipse -->
    <TextView
        android:id="@+id/tool_ellipse"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:gravity="center"
        android:text="@string/tool_ellipse"
        android:textSize="14sp"
        android:textColor="@color/tool_item_text_default"
        android:background="@drawable/bg_tool_item_default"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="3dp"
        android:fontFamily="sans-serif" />

    <!-- Stroke Eraser -->
    <TextView
        android:id="@+id/tool_stroke_eraser"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:gravity="center"
        android:text="@string/tool_stroke_eraser"
        android:textSize="14sp"
        android:textColor="@color/tool_item_text_default"
        android:background="@drawable/bg_tool_item_default"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="3dp"
        android:fontFamily="sans-serif" />

    <!-- Pixel Eraser -->
    <TextView
        android:id="@+id/tool_pixel_eraser"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:gravity="center"
        android:text="@string/tool_pixel_eraser"
        android:textSize="14sp"
        android:textColor="@color/tool_item_text_default"
        android:background="@drawable/bg_tool_item_default"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:fontFamily="sans-serif" />

</LinearLayout>
