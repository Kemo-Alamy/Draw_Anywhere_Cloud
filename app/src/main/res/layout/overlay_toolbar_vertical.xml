<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@drawable/bg_toolbar"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:elevation="8dp">

    <!-- ① Eye -->
    <ImageView
        android:id="@+id/btn_hide"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:padding="11dp"
        android:src="@drawable/ic_eye"
        android:tint="@color/toolbar_icon_default"
        android:scaleType="fitCenter"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/cd_btn_hide" />

    <!-- ② Undo (باهت افتراضياً) -->
    <ImageView
        android:id="@+id/btn_undo"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:padding="11dp"
        android:src="@drawable/ic_undo"
        android:tint="@color/toolbar_icon_default"
        android:scaleType="fitCenter"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:focusable="true"
        android:alpha="0.35"
        android:enabled="false"
        android:contentDescription="@string/cd_btn_undo" />

    <!-- ③ Clear/Trash (باهت افتراضياً) -->
    <ImageView
        android:id="@+id/btn_clear"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:padding="11dp"
        android:src="@drawable/ic_trash"
        android:tint="@color/toolbar_icon_default"
        android:scaleType="fitCenter"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:focusable="true"
        android:alpha="0.35"
        android:enabled="false"
        android:contentDescription="@string/cd_btn_clear" />

    <!-- ④ Add Image -->
    <ImageView
        android:id="@+id/btn_add_image"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:padding="11dp"
        android:src="@drawable/ic_image"
        android:tint="@color/toolbar_icon_default"
        android:scaleType="fitCenter"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/cd_btn_image" />

    <!-- ⑤ Tools -->
    <ImageView
        android:id="@+id/btn_tools"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:padding="11dp"
        android:src="@drawable/ic_pen"
        android:tint="@color/toolbar_icon_default"
        android:scaleType="fitCenter"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/cd_btn_tools" />

    <View
        android:id="@+id/toolbar_divider"
        android:layout_width="32dp"
        android:layout_height="1dp"
        android:background="@color/toolbar_divider"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="3dp" />

    <!-- ⑥ Color Dot -->
    <FrameLayout
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_color_dot_ring"
        android:clipToOutline="true"
        android:contentDescription="@string/cd_color_dot">
        <View
            android:id="@+id/view_color_dot"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/toolbar_dot_red" />
    </FrameLayout>

    <!-- ⑦ Finger — زرار حقيقي -->
    <ImageView
        android:id="@+id/btn_finger"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:padding="11dp"
        android:src="@drawable/ic_finger"
        android:tint="@color/toolbar_icon_default"
        android:scaleType="fitCenter"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/cd_btn_finger" />

    <!-- ⑧ Settings -->
    <ImageView
        android:id="@+id/btn_settings"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:padding="11dp"
        android:src="@drawable/ic_settings"
        android:tint="@color/toolbar_icon_default"
        android:scaleType="fitCenter"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/cd_btn_settings" />

</LinearLayout>
