<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <View
        android:layout_width="4dp"
        android:layout_height="30dp"
        android:background="@drawable/bg_grip_handle"
        android:layout_marginEnd="3dp" />

    <LinearLayout
        android:id="@+id/toolbar_content_col"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/bg_toolbar"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:elevation="8dp">

        <!-- ✅ العين — دايماً ظاهرة -->
        <ImageView
            android:id="@+id/btn_hide"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:padding="11dp"
            android:src="@drawable/ic_eye"
            android:tint="@color/toolbar_icon_default"
            android:scaleType="fitCenter"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/cd_btn_hide" />

        <ImageView
            android:id="@+id/btn_undo"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:padding="11dp"
            android:src="@drawable/ic_undo"
            android:tint="@color/toolbar_icon_default"
            android:scaleType="fitCenter"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            android:alpha="0.35"
            android:enabled="false"
            android:contentDescription="@string/cd_btn_undo" />

        <!-- ✅ الزر المضاف بنفس الخصائص والمقاسات التي أرسلتها -->
        <ImageView
            android:id="@+id/btn_redo"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:padding="9dp"
            android:src="@drawable/ic_redo"
            android:alpha="0.35"
            android:contentDescription="Redo"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <ImageView
            android:id="@+id/btn_clear"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:padding="11dp"
            android:src="@drawable/ic_trash"
            android:tint="@color/toolbar_icon_default"
            android:scaleType="fitCenter"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            android:alpha="0.35"
            android:enabled="false"
            android:contentDescription="@string/cd_btn_clear" />

        <ImageView
            android:id="@+id/btn_tools"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:padding="11dp"
            android:src="@drawable/ic_pen"
            android:tint="@color/toolbar_icon_default"
            android:scaleType="fitCenter"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/cd_btn_tools" />

        <com.drawanywhere.app.ColorDropView
            android:id="@+id/view_color_dot"
            android:layout_width="30dp"
            android:layout_height="34dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/cd_color_dot" />

        <View
            android:id="@+id/toolbar_divider"
            android:layout_width="26dp"
            android:layout_height="1dp"
            android:background="@color/toolbar_divider"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            android:visibility="gone" />

        <ScrollView
            android:id="@+id/toolbar_scroll_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:requiresFadingEdge="vertical"
            android:fadingEdgeLength="@dimen/toolbar_fading_edge_length">

            <LinearLayout
                android:id="@+id/toolbar_scroll_inner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <ImageView
                    android:id="@+id/btn_add_image"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:padding="11dp"
                    android:src="@drawable/ic_image"
                    android:tint="@color/toolbar_icon_default"
                    android:scaleType="fitCenter"
                    android:background="@android:color/transparent"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/cd_btn_image" />

                <ImageView
                    android:id="@+id/btn_finger"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:padding="11dp"
                    android:src="@drawable/ic_finger"
                    android:tint="@color/toolbar_icon_default"
                    android:scaleType="fitCenter"
                    android:background="@android:color/transparent"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/cd_btn_finger" />

                <ImageView
                    android:id="@+id/btn_settings"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:padding="11dp"
                    android:src="@drawable/ic_settings"
                    android:tint="@color/toolbar_icon_default"
                    android:scaleType="fitCenter"
                    android:background="@android:color/transparent"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/cd_btn_settings" />

            </LinearLayout>
        </ScrollView>

        <!-- ✅ أضفنا id للحاوية -->
        <FrameLayout
            android:id="@+id/btn_collapse_arrow_container"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginTop="2dp"
            android:background="@drawable/bg_collapse_pill">
            <ImageView
                android:id="@+id/btn_collapse_arrow"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="6dp"
                android:src="@drawable/ic_chevron_down"
                android:tint="@color/toolbar_icon_default"
                android:scaleType="fitCenter"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/cd_btn_collapse" />
        </FrameLayout>

    </LinearLayout>

</LinearLayout>
