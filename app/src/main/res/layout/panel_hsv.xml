<?xml version="1.0" encoding="utf-8"?>
<!--
    HSV Color Picker Panel
    ① HsvColorPickerView  → R.id.hsv_picker
    ② Hex Input TextView  → R.id.tv_hex_value
    ③ Brightness SeekBar  → R.id.seek_brightness
    ④ Apply Button        → R.id.btn_apply
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="260dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_panel"
    android:padding="14dp"
    android:elevation="8dp">

    <!-- ── Header Row: دائرة حمراء + عنوان HSV ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <View
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:background="@drawable/bg_color_dot_ring"
            android:layout_marginEnd="8dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="HSV"
            android:textColor="@color/panel_text"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium" />

        <!-- مربع الـ Hex -->
        <FrameLayout
            android:layout_width="100dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_hex_input">
            <TextView
                android:id="@+id/tv_hex_value"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="#FF0000"
                android:textColor="@color/hsv_hex_text"
                android:textSize="13sp"
                android:fontFamily="monospace" />
        </FrameLayout>
    </LinearLayout>

    <!-- ── Color Wheel ── -->
    <com.drawanywhere.app.HsvColorPickerView
        android:id="@+id/hsv_picker"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginBottom="12dp" />

    <!-- ── Brightness (V) Slider ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:layout_width="12dp"
            android:layout_height="wrap_content"
            android:text="H"
            android:textColor="@color/panel_subtext"
            android:textSize="11sp"
            android:layout_marginEnd="6dp" />

        <SeekBar
            android:id="@+id/seek_brightness"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="100"
            android:progress="100"
            android:progressTint="@color/slider_track_active"
            android:thumbTint="@color/slider_thumb_color"
            android:progressBackgroundTint="@color/slider_track_inactive" />
    </LinearLayout>

    <!-- S Slider (placeholder — يُشغَّل من HsvColorPickerView مباشرةً) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:layout_width="12dp"
            android:layout_height="wrap_content"
            android:text="S"
            android:textColor="@color/panel_subtext"
            android:textSize="11sp"
            android:layout_marginEnd="6dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_weight="1"
            android:background="@color/slider_track_inactive" />
    </LinearLayout>

    <!-- V Slider -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="14dp">

        <TextView
            android:layout_width="12dp"
            android:layout_height="wrap_content"
            android:text="V"
            android:textColor="@color/panel_subtext"
            android:textSize="11sp"
            android:layout_marginEnd="6dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_weight="1"
            android:background="@color/slider_track_inactive" />
    </LinearLayout>

    <!-- ── APPLY Button ── -->
    <TextView
        android:id="@+id/btn_apply"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center"
        android:text="@string/btn_apply"
        android:textColor="@color/btn_apply_text"
        android:textSize="14sp"
        android:textStyle="bold"
        android:letterSpacing="0.05"
        android:background="@drawable/bg_btn_apply"
        android:fontFamily="sans-serif-medium" />

</LinearLayout>
