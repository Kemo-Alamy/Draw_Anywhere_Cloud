<?xml version="1.0" encoding="utf-8"?>
<!--
    Settings Panel — يطابق الـ Screenshot بالظبط:
    ① Horizontal / Vertical buttons
    ② Clear canvas on hide  (CheckBox)
    ③ Open canvas on start  (CheckBox)
    ④ Finger drawing        (CheckBox)
    ⑤ Quit button
    ⑥ About section
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="200dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_panel"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:elevation="8dp">

    <!-- ── Panel Title ── -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/panel_settings"
        android:textColor="@color/panel_subtext"
        android:textSize="11sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="14dp"
        android:layout_marginBottom="8dp"
        android:textAllCaps="true"
        android:letterSpacing="0.08" />

    <!-- ── Horizontal / Vertical Toggle Row ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/btn_horizontal"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/settings_horizontal"
            android:textSize="13sp"
            android:background="@drawable/bg_setting_selected"
            android:textColor="@color/setting_selected_text"
            android:layout_marginEnd="4dp"
            android:fontFamily="sans-serif" />

        <TextView
            android:id="@+id/btn_vertical"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/settings_vertical"
            android:textSize="13sp"
            android:background="@drawable/bg_setting_unselected"
            android:textColor="@color/setting_unselected_text"
            android:fontFamily="sans-serif" />

    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/panel_section_divider"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp" />

    <!-- ── Clear canvas on hide ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings_clear_on_hide"
            android:textColor="@color/panel_text"
            android:textSize="13sp"
            android:fontFamily="sans-serif" />

        <CheckBox
            android:id="@+id/chk_clear_on_hide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="@color/setting_toggle_tint"
            android:checked="false" />

    </LinearLayout>

    <!-- ── Open canvas on start ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings_open_on_start"
            android:textColor="@color/panel_text"
            android:textSize="13sp"
            android:fontFamily="sans-serif" />

        <CheckBox
            android:id="@+id/chk_open_on_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="@color/setting_toggle_tint"
            android:checked="true" />

    </LinearLayout>

    <!-- ── Finger drawing ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings_finger_drawing"
            android:textColor="@color/panel_text"
            android:textSize="13sp"
            android:fontFamily="sans-serif" />

        <CheckBox
            android:id="@+id/chk_finger_drawing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="@color/setting_toggle_tint"
            android:checked="true" />

    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/panel_section_divider"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp" />

    <!-- ── Quit Button ── -->
    <TextView
        android:id="@+id/btn_quit"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center"
        android:text="@string/settings_quit"
        android:textColor="@color/btn_quit_text"
        android:textSize="14sp"
        android:background="@android:color/transparent"
        android:fontFamily="sans-serif" />

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/panel_section_divider"
        android:layout_marginBottom="6dp" />

    <!-- ── About Section ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="4dp"
        android:gravity="center_horizontal">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@mipmap/ic_launcher"
            android:scaleType="fitCenter"
            android:layout_marginBottom="4dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/about_app_name"
            android:textColor="@color/panel_text"
            android:textSize="13sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/about_text"
            android:textColor="@color/panel_subtext"
            android:textSize="10sp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3"
            android:fontFamily="sans-serif" />

    </LinearLayout>

</LinearLayout>
