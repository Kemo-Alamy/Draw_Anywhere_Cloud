<?xml version="1.0" encoding="utf-8"?>
<!--
    حاوية الألوان الخارجية — ViewPager2 بصفحتين (Swatches / HSV Wheel)
    + Dots Indicator — بالظبط زي الـ Settings
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_panel"
    android:elevation="8dp">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/color_pager"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:paddingTop="2dp"
        android:paddingBottom="8dp">

        <View
            android:id="@+id/color_dot_0"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginEnd="5dp"
            android:background="@drawable/bg_dot_active" />

        <View
            android:id="@+id/color_dot_1"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:background="@drawable/bg_dot_inactive" />

    </LinearLayout>

</LinearLayout>
