<?xml version="1.0" encoding="utf-8"?>
<!--
    Color Panel:
    ① دائرة اللون الحالي (تفتح HSV Picker عند الضغط) → view_current_color
    ② شبكة 20 لون (4 صفوف × 5 أعمدة) → color_01 … color_20
    ③ Slider العرض → seek_width + label_width_value
    ④ Slider الشفافية → seek_opacity + label_opacity_value
    كل Swatch مغلّف في FrameLayout يحدّ الـ View بشكل دائري عبر clipToOutline
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_panel"
    android:padding="12dp"
    android:elevation="8dp"
    android:minWidth="220dp">

    <!-- ═══════════ Header: Current Color + Label ═══════════ -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <FrameLayout
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_color_dot_ring"
            android:clipToOutline="true"
            android:contentDescription="@string/cd_color_dot">
            <View
                android:id="@+id/view_current_color"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/toolbar_dot_red" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/panel_color"
            android:textColor="@color/panel_text"
            android:textSize="15sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <!-- ═══════════ Swatches: Row 1 (preset_01 – preset_05) ═══════════ -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="2dp">
        <FrameLayout android:layout_width="34dp" android:layout_height="34dp" android:layout_margin="3dp" android:background="@drawable/bg_swatch_mask" android:clipToOutline="true"><View android:id="@+id/color_01" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/preset_01"/></FrameLayout>
        <FrameLayout android:layout_width="34dp" android:layout_height="34dp" android:layout_margin="3dp" android:background="@drawable/bg_swatch_mask" android:clipToOutline="true"><View android:id="@+id/color_02" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/preset_02"/></FrameLayout>
        <FrameLayout android:layout_width="34dp" android:layout_height="34dp" android:layout_margin="3dp" android:background="@drawable/bg_swatch_mask" android:clipToOutline="true"><View android:id="@+id/color_03" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/preset_03"/></FrameLayout>
        <FrameLayout android:layout_width="34dp" android:layout_height="34dp" android:layout_margin="3dp" android:background="@drawable/bg_swatch_mask" android:clipToOutline="true"><View android:id="@+id/color_04" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/preset_04"/></FrameLayout>
        <FrameLayout android:layout_width="34dp" android:layout_height="34dp" android:layout_margin="3dp" android:background="@drawable/bg_swatch_mask" android:clipToOutline="true"><View android:id="@+id/color_05" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/preset_05"/></FrameLayout>
    </LinearLayout>

    <!-- Row 2 (preset_06 – preset_10) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="2dp">
        <FrameLayout android:layout_width="34dp" android:layout_height="34dp" android:layout_margin="3dp" android:background="@drawable/bg_swatch_mask" android:clipToOutline="true"><View android:id="@+id/color_06" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/preset_06"/></FrameLayout>
        <FrameLayout android:layout_width="34dp" android:layout_height="34dp" android:layout_margin="3dp" android:background="@drawable/bg_swatch_mask" android:clipToOutline="true"><View android:id="@+id/color_07" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/preset_07"/></FrameLayout>
        <FrameLayout android:layout_width="34dp" android:layout_height="34dp" android:layout_margin="3dp" android:background="@drawable/bg_swatch_mask" android:clipToOutline="true"><View android:id="@+id/color_08" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/preset_08"/></FrameLayout>
        <FrameLayout android:layout_width="34dp" android:layout_height="34dp" android:layout_margin="3dp" android:background="@drawable/bg_swatch_mask" android:clipToOutline="true"><View android:id="@+id/color_09" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/preset_09"/></FrameLayout>
        <FrameLayout android:layout_width="34dp" android:layout_height="34dp" android:layout_margin="3dp" android:background="@drawable/bg_swatch_mask" android:clipToOutline="true"><View android:id="@+id/color_10" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/preset_10"/></FrameLayout>
    </LinearLayout>

    <!-- Row 3 (preset_11 – preset_15) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="2dp">
        <FrameLayout android:layout_width="34dp" android:layout_height="34dp" android:layout_margin="3dp" android:background="@drawable/bg_swatch_mask" android:clipToOutline="true"><View android:id="@+id/color_11" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/preset_11"/></FrameLayout>
        <FrameLayout android:layout_width="34dp" android:layout_height="34dp" android:layout_margin="3dp" android:background="@drawable/bg_swatch_mask" android:clipToOutline="true"><View android:id="@+id/color_12" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/preset_12"/></FrameLayout>
        <FrameLayout android:layout_width="34dp" android:layout_height="34dp" android:layout_margin="3dp" android:background="@drawable/bg_swatch_mask" android:clipToOutline="true"><View android:id="@+id/color_13" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/preset_13"/></FrameLayout>
        <FrameLayout android:layout_width="34dp" android:layout_height="34dp" android:layout_margin="3dp" android:background="@drawable/bg_swatch_mask" android:clipToOutline="true"><View android:id="@+id/color_14" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/preset_14"/></FrameLayout>
        <FrameLayout android:layout_width="34dp" android:layout_height="34dp" android:layout_margin="3dp" android:background="@drawable/bg_swatch_mask" android:clipToOutline="true"><View android:id="@+id/color_15" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/preset_15"/></FrameLayout>
    </LinearLayout>

    <!-- Row 4 (preset_16 – preset_20: أبيض ← رمادي فاتح ← رمادي ← رمادي داكن ← أسود) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">
        <FrameLayout android:layout_width="34dp" android:layout_height="34dp" android:layout_margin="3dp" android:background="@drawable/bg_swatch_mask" android:clipToOutline="true"><View android:id="@+id/color_16" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/preset_16"/></FrameLayout>
        <FrameLayout android:layout_width="34dp" android:layout_height="34dp" android:layout_margin="3dp" android:background="@drawable/bg_swatch_mask" android:clipToOutline="true"><View android:id="@+id/color_17" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/preset_17"/></FrameLayout>
        <FrameLayout android:layout_width="34dp" android:layout_height="34dp" android:layout_margin="3dp" android:background="@drawable/bg_swatch_mask" android:clipToOutline="true"><View android:id="@+id/color_18" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/preset_18"/></FrameLayout>
        <FrameLayout android:layout_width="34dp" android:layout_height="34dp" android:layout_margin="3dp" android:background="@drawable/bg_swatch_mask" android:clipToOutline="true"><View android:id="@+id/color_19" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/preset_19"/></FrameLayout>
        <FrameLayout android:layout_width="34dp" android:layout_height="34dp" android:layout_margin="3dp" android:background="@drawable/bg_swatch_mask" android:clipToOutline="true"><View android:id="@+id/color_20" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/preset_20"/></FrameLayout>
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/panel_section_divider"
        android:layout_marginBottom="8dp" />

    <!-- ═══════════ Tool Controls Section ═══════════ -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/panel_tool_controls"
        android:textColor="@color/panel_subtext"
        android:textSize="12sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="8dp" />

    <!-- Width Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:text="@string/label_width"
            android:textColor="@color/panel_text"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/seek_width"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="95"
            android:progress="3"
            android:progressTint="@color/slider_track_active"
            android:thumbTint="@color/slider_thumb_color"
            android:progressBackgroundTint="@color/slider_track_inactive" />

        <TextView
            android:id="@+id/label_width_value"
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:text="8px"
            android:textColor="@color/panel_text"
            android:textSize="11sp"
            android:gravity="end" />
    </LinearLayout>

    <!-- Opacity Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:text="@string/label_opacity"
            android:textColor="@color/panel_text"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/seek_opacity"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="100"
            android:progress="100"
            android:progressTint="@color/slider_track_active"
            android:thumbTint="@color/slider_thumb_color"
            android:progressBackgroundTint="@color/slider_track_inactive" />

        <TextView
            android:id="@+id/label_opacity_value"
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:text="100%"
            android:textColor="@color/panel_text"
            android:textSize="11sp"
            android:gravity="end" />
    </LinearLayout>

</LinearLayout>
