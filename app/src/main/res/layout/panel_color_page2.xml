<?xml version="1.0" encoding="utf-8"?>
<!-- صفحة 2: HSV Wheel — تظهر بالـ Swipe لليمين من صفحة الألوان -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="220dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="HSV"
            android:textColor="@color/panel_text"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium" />

        <FrameLayout
            android:layout_width="100dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_hex_input">
            <TextView
                android:id="@+id/tv_hex_value"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="#FF0000"
                android:textColor="@color/hsv_hex_text"
                android:textSize="13sp"
                android:fontFamily="monospace" />
        </FrameLayout>
    </LinearLayout>

    <com.drawanywhere.app.HsvColorPickerView
        android:id="@+id/hsv_picker"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginBottom="10dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">
        <TextView android:layout_width="14dp" android:layout_height="wrap_content" android:text="V" android:textColor="@color/panel_subtext" android:textSize="11sp" android:layout_marginEnd="6dp"/>
        <SeekBar
            android:id="@+id/seek_brightness"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="100"
            android:progress="100"
            android:progressTint="@color/slider_track_active"
            android:thumbTint="@color/slider_thumb_color"
            android:progressBackgroundTint="@color/slider_track_inactive" />
    </LinearLayout>

    <TextView
        android:id="@+id/btn_apply"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:gravity="center"
        android:text="@string/btn_apply"
        android:textColor="@color/btn_apply_text"
        android:textSize="14sp"
        android:textStyle="bold"
        android:background="@drawable/bg_btn_apply" />

</LinearLayout>
