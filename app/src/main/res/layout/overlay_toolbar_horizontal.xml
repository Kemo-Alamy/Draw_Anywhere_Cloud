<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_toolbar"
    android:paddingStart="6dp"
    android:paddingEnd="6dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:elevation="8dp"
    android:animateLayoutChanges="true">

    <!-- ① Eye -->
    <ImageView
        android:id="@+id/btn_hide"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:padding="10dp"
        android:src="@drawable/ic_eye"
        android:tint="@color/toolbar_icon_default"
        android:scaleType="fitCenter"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/cd_btn_hide" />

    <!-- ② Undo (يبدأ باهت لحد ما فيه رسم) -->
    <ImageView
        android:id="@+id/btn_undo"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:padding="10dp"
        android:src="@drawable/ic_undo"
        android:tint="@color/toolbar_icon_default"
        android:scaleType="fitCenter"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:focusable="true"
        android:alpha="0.35"
        android:enabled="false"
        android:contentDescription="@string/cd_btn_undo" />

    <!-- ③ Color Dot — ✅ أضفنا id للـ FrameLayout نفسه عشان نقدر نخفيه كامل وقت الـ Collapse -->
    <FrameLayout
        android:id="@+id/color_dot_container"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/bg_color_dot_ring"
        android:clipToOutline="true"
        android:contentDescription="@string/cd_color_dot">
        <View
            android:id="@+id/view_color_dot"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/toolbar_dot_red" />
    </FrameLayout>

    <!-- ④ Finger — زرار حقيقي يبدل Touch Pass-Through -->
    <ImageView
        android:id="@+id/btn_finger"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:padding="10dp"
        android:src="@drawable/ic_finger"
        android:tint="@color/toolbar_icon_default"
        android:scaleType="fitCenter"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/cd_btn_finger" />

    <!-- ⑤ Settings -->
    <ImageView
        android:id="@+id/btn_settings"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:padding="10dp"
        android:src="@drawable/ic_settings"
        android:tint="@color/toolbar_icon_default"
        android:scaleType="fitCenter"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/cd_btn_settings" />

</LinearLayout>
