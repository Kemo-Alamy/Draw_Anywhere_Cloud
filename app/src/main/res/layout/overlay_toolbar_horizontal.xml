<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal">

    <View
        android:layout_width="30dp"
        android:layout_height="4dp"
        android:background="@drawable/bg_grip_handle"
        android:layout_marginBottom="3dp" />

    <LinearLayout
        android:id="@+id/toolbar_content_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_toolbar"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:elevation="8dp">

        <ImageView
            android:id="@+id/btn_hide"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:padding="10dp"
            android:src="@drawable/ic_eye"
            android:tint="@color/toolbar_icon_default"
            android:scaleType="fitCenter"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/cd_btn_hide" />

        <ImageView
            android:id="@+id/btn_undo"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:padding="10dp"
            android:src="@drawable/ic_undo"
            android:tint="@color/toolbar_icon_default"
            android:scaleType="fitCenter"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            android:alpha="0.35"
            android:enabled="false"
            android:contentDescription="@string/cd_btn_undo" />

        <ImageView
            android:id="@+id/btn_redo"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:padding="10dp"
            android:src="@drawable/ic_redo"
            android:tint="@color/toolbar_icon_default"
            android:scaleType="fitCenter"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            android:alpha="0.35"
            android:enabled="false"
            android:contentDescription="Redo" />

        <!-- ✅ زرار السلة كان ناقص من الأفقي — أضيف دلوقتي -->
        <ImageView
            android:id="@+id/btn_clear"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:padding="10dp"
            android:src="@drawable/ic_trash"
            android:tint="@color/toolbar_icon_default"
            android:scaleType="fitCenter"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            android:alpha="0.35"
            android:enabled="false"
            android:contentDescription="@string/cd_btn_clear" />

        <!-- ✅ نفس مقاس وpadding باقي الأيقونات بالظبط -->
        <ImageView
            android:id="@+id/view_color_dot"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:padding="10dp"
            android:src="@drawable/ic_palette"
            android:scaleType="fitCenter"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/cd_color_dot" />

        <ImageView
            android:id="@+id/btn_tools"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:padding="10dp"
            android:src="@drawable/ic_pen"
            android:tint="@color/toolbar_icon_default"
            android:scaleType="fitCenter"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/cd_btn_tools" />

        <View
            android:id="@+id/toolbar_divider"
            android:layout_width="1dp"
            android:layout_height="26dp"
            android:background="@color/toolbar_divider"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:visibility="gone" />

        <HorizontalScrollView
            android:id="@+id/toolbar_scroll_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:requiresFadingEdge="horizontal"
            android:fadingEdgeLength="@dimen/toolbar_fading_edge_length"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/toolbar_scroll_inner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/btn_add_image"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:padding="10dp"
                    android:src="@drawable/ic_image"
                    android:tint="@color/toolbar_icon_default"
                    android:scaleType="fitCenter"
                    android:background="@android:color/transparent"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/cd_btn_image" />

                <ImageView
                    android:id="@+id/btn_finger"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:padding="10dp"
                    android:src="@drawable/ic_finger"
                    android:tint="@color/toolbar_icon_default"
                    android:scaleType="fitCenter"
                    android:background="@android:color/transparent"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/cd_btn_finger" />

                <ImageView
                    android:id="@+id/btn_settings"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:padding="10dp"
                    android:src="@drawable/ic_settings"
                    android:tint="@color/toolbar_icon_default"
                    android:scaleType="fitCenter"
                    android:background="@android:color/transparent"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/cd_btn_settings" />

            </LinearLayout>
        </HorizontalScrollView>

        <!-- ✅ السهم دلوقتي آخر حاجة في الصف -->
        <FrameLayout
            android:id="@+id/btn_collapse_arrow_container"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="2dp"
            android:background="@drawable/bg_collapse_pill"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/btn_collapse_arrow"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="6dp"
                android:src="@drawable/ic_chevron_right"
                android:tint="@color/toolbar_icon_default"
                android:scaleType="fitCenter"
                android:contentDescription="@string/cd_btn_collapse" />
        </FrameLayout>

    </LinearLayout>

</LinearLayout>
